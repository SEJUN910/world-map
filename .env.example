# Set the real origin before public deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: paste verification token values, not entire meta tags.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# Enable only after configuring Google provider + manual identity linking in Supabase.
GOOGLE_AUTH_ENABLED=false
# Optional local setup inputs for scripts/setup-google-auth.mjs. Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public client configuration. Never put service-role or management tokens here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: data.go.kr TourAPI 일반 인증키 (Decoding).
TOUR_API_SERVICE_KEY=

# Server-only: Geoapify address search. Do not use a NEXT_PUBLIC_ prefix.
GEOAPIFY_API_KEY=

# Server-only first-party usage analytics. Never prefix with NEXT_PUBLIC_.
# The write key must match the hash in analytics_settings (configured via MCP).
ANALYTICS_WRITE_KEY=
# Development/localhost traffic is excluded unless explicitly enabled for testing.
# ANALYTICS_INCLUDE_LOCAL=true

# Optional runtime tile provider override; provide both values together.
# The default is the public OpenStreetMap standard tile server.
# MAP_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=Map data attribution
